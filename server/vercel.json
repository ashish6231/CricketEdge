{
  "version": 2,
  "builds": [{ "src": "index.js", "use": "@vercel/node", "config": { "maxDuration": 30, "installCommand": "npm install && npx prisma generate" } }],
  "routes": [{ "src": "/(.*)", "dest": "index.js" }],
  "crons": [
    {
      "path": "/api/cron/activate-subscriptions",
      "schedule": "0 0 * * *"
    }
  ]
}
