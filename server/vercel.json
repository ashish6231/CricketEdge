{
  "version": 2,
  "builds": [{ "src": "index.js", "use": "@vercel/node" }],
  "routes": [{ "src": "/(.*)", "dest": "index.js" }],
  "crons": [
    {
      "path": "/api/cron/activate-subscriptions",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "index.js": {
      "maxDuration": 30
    }
  }
}
